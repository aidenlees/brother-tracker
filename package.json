{
  "name": "brother-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check . && node scripts/check-tokens.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "seed": "node scripts/seed.ts",
    "e2e:fixtures": "node scripts/e2e-fixtures.ts",
    "env:local": "node scripts/local-env.ts",
    "gen:icons": "pwa-assets-generator",
    "gen:parity": "vitest run src/trackers/parity.test.ts --update",
    "gen:types": "supabase gen types --lang typescript --schema public > src/lib/database.types.ts && prettier --write src/lib/database.types.ts",
    "check:tokens": "node scripts/check-tokens.ts",
    "check:secrets": "node scripts/check-secrets.ts src dist"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "supabase": "3.0.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/query-async-storage-persister": "5.105.3",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-query-persist-client": "5.105.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.67.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  }
}
