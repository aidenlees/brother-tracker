{
  "_note": "Launch tracker definitions. Field and metric types must match the registry described in CLAUDE.md. Load with the seed script; never put user IDs or emails in this file.",
  "trackers": [
    {
      "slug": "singapore-math",
      "name": "Singapore Math",
      "icon": "calculator",
      "color": "ink-blue",
      "sort": 1,
      "cadence": { "type": "plan", "plan_source": "seed/math_sessions.json" },
      "field_version": 2,
      "fields": [
        {
          "key": "completed",
          "type": "yes_no",
          "label": "Did you complete the problems on the pages?",
          "required": true,
          "showIf": { "plan.reading_only": false }
        },
        {
          "key": "read",
          "type": "yes_no",
          "label": "Did you finish the reading?",
          "required": true,
          "showIf": { "plan.reading_only": true }
        },
        {
          "key": "struggled",
          "type": "plan_checklist",
          "label": "Which problems did you struggle with?",
          "required": false,
          "help": "Check the ones you couldn't do on your own.",
          "optionsFrom": "plan.problems"
        },
        { "key": "minutes", "type": "duration", "label": "Minutes", "required": true }
      ],
      "metrics": [
        {
          "key": "completed_week",
          "type": "count_where",
          "label": "Sessions completed",
          "where": "completed or read",
          "period": "week"
        },
        { "key": "minutes_week", "type": "sum", "label": "Minutes", "field": "minutes", "period": "week" },
        {
          "key": "independent_rate",
          "type": "ratio",
          "label": "Solved on my own",
          "numerator": "count(plan.problems) - count(struggled)",
          "denominator": "count(plan.problems)",
          "format": "percent",
          "nullWhen": "denominator = 0"
        }
      ],
      "followups": {
        "from": "struggled",
        "defaultDueDays": 2,
        "listAllOpenWhen": { "plan.kind": ["review", "mixed_check"] }
      },
      "pacingFlags": [
        {
          "key": "slow_down",
          "label": "Slow down: address the gap",
          "when": { "type": "week_below", "metric": "independent_rate", "value": 0.5 },
          "audience": "admin"
        },
        {
          "key": "trim_repetition",
          "label": "Consider trimming repetition",
          "when": { "type": "last_sessions_at_least", "metric": "independent_rate", "sessions": 3, "value": 0.8 },
          "audience": "admin"
        },
        {
          "key": "behind_plan",
          "label": "Behind plan",
          "when": { "type": "missed_sessions", "atLeast": 2 },
          "audience": "admin"
        }
      ]
    },
    {
      "slug": "violin",
      "name": "Violin",
      "icon": "music",
      "color": "rosin-amber",
      "sort": 2,
      "cadence": { "type": "daily" },
      "field_version": 1,
      "display": "inline_on_today_card",
      "fields": [
        { "key": "practiced", "type": "yes_no", "label": "Did you practice today?", "required": true },
        {
          "key": "focus",
          "type": "short_text",
          "label": "One specific thing you focused on",
          "required": true,
          "placeholder": "clean shift to 3rd position in bar 12",
          "showIf": { "practiced": true }
        }
      ],
      "metrics": [
        { "key": "days_week", "type": "days_per_week", "label": "Practice days", "where": "practiced" },
        { "key": "streak", "type": "streak", "label": "Streak", "where": "practiced" }
      ]
    },
    {
      "slug": "tasks",
      "name": "Tasks",
      "icon": "list-checks",
      "color": "moss",
      "sort": 3,
      "cadence": { "type": "plan" },
      "field_version": 1,
      "display": "task_list",
      "fields": [{ "key": "done", "type": "checkbox", "label": "Done", "required": true }],
      "metrics": [{ "key": "done_week", "type": "count_where", "label": "Tasks done", "where": "done", "period": "week" }]
    }
  ]
}
